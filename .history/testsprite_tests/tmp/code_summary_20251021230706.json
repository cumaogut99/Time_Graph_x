{
  "project_name": "Time Graph Widget",
  "project_version": "1.0.0",
  "project_description": "Gelişmiş veri analizi ve görselleştirme için tasarlanmış profesyonel PyQt5 masaüstü uygulaması. Çoklu dosya desteği, gerçek zamanlı istatistikler, gelişmiş filtreleme ve analiz araçları sunar.",
  "tech_stack": {
    "language": "Python 3.8+",
    "framework": "PyQt5",
    "ui_framework": "PyQt5",
    "data_processing": [
      "Polars (high-performance)",
      "NumPy",
      "Pandas (fallback)"
    ],
    "visualization": [
      "PyQtGraph",
      "Matplotlib"
    ],
    "build_tools": [
      "PyInstaller"
    ]
  },
  "dependencies": {
    "PyQt5": ">=5.15.0",
    "numpy": ">=1.21.0",
    "polars": ">=0.19.0",
    "pandas": ">=1.4.0",
    "matplotlib": ">=3.5.0",
    "pyinstaller": ">=5.0.0",
    "pillow": ">=8.0.0",
    "openpyxl": ">=3.0.0"
  },
  "main_features": [
    {
      "feature": "Çoklu Dosya Yönetimi",
      "description": "Aynı anda 3 dosyaya kadar açabilme ve tab'lar arasında geçiş",
      "files": [
        "src/managers/multi_file_manager.py",
        "src/managers/widget_container_manager.py"
      ]
    },
    {
      "feature": "Veri İçe Aktarma",
      "description": "CSV, Excel, Parquet formatlarında veri yükleme, gelişmiş import dialog",
      "files": [
        "src/data/data_import_dialog.py",
        "src/data/data_loader.py",
        "src/data/data_cache_manager.py"
      ]
    },
    {
      "feature": "Çoklu Grafik Görüntüleme",
      "description": "1-6 arası grafik oluşturma, özelleştirilebilir layout",
      "files": [
        "src/graphics/graph_container.py",
        "src/graphics/graph_renderer.py",
        "src/managers/plot_manager.py"
      ]
    },
    {
      "feature": "Gelişmiş Filtreleme",
      "description": "Range-based filtreleme, segmented ve concatenated modlar, thread-safe hesaplama",
      "files": [
        "src/managers/filter_manager.py"
      ]
    },
    {
      "feature": "İstatistiksel Analiz",
      "description": "Min, Max, Avg, RMS, Std Dev, korelasyon analizi",
      "files": [
        "src/ui/statistics_panel.py",
        "src/managers/correlations_panel_manager.py"
      ]
    },
    {
      "feature": "Cursor Araçları",
      "description": "Single ve Dual cursor modları, hassas ölçüm",
      "files": [
        "src/managers/cursor_manager.py"
      ]
    },
    {
      "feature": "Proje Dosyaları (.mpai)",
      "description": "Veri + Layout tek dosyada kaydetme/yükleme (Parquet tabanlı)",
      "files": [
        "src/managers/project_file_manager.py"
      ]
    },
    {
      "feature": "Tema Sistemi",
      "description": "Light, Dark ve Custom temalar",
      "files": [
        "src/managers/theme_manager.py"
      ]
    },
    {
      "feature": "Bitmask Analizi",
      "description": "Dijital sinyal analizi, bit seviyesi inceleme",
      "files": [
        "src/managers/bitmask_panel_manager.py"
      ]
    },
    {
      "feature": "Performans İzleme",
      "description": "Sistem kaynak kullanımı (CPU, RAM) izleme",
      "files": [
        "src/managers/status_bar_manager.py"
      ]
    }
  ],
  "architecture": {
    "pattern": "MVC + Manager Pattern",
    "main_window": "app.py - TimeGraphApp",
    "core_widget": "time_graph_widget.py - TimeGraphWidget",
    "managers": [
      "data_manager.py - Veri yönetimi",
      "filter_manager.py - Filtreleme işlemleri",
      "plot_manager.py - Grafik çizimi",
      "cursor_manager.py - Cursor yönetimi",
      "theme_manager.py - Tema yönetimi",
      "toolbar_manager.py - Araç çubuğu",
      "status_bar_manager.py - Durum çubuğu",
      "multi_file_manager.py - Çoklu dosya",
      "widget_container_manager.py - Widget konteyner",
      "project_file_manager.py - Proje dosyaları"
    ]
  },
  "performance_features": [
    "Polars ile hızlı veri işleme (Pandas'tan 5-10x hızlı)",
    "Parquet cache sistemi (8-27x hızlı yükleme)",
    "Thread-based veri yükleme",
    "QThread ile arka plan hesaplamaları",
    "Debouncing ile gereksiz hesaplama önleme"
  ],
  "data_formats": {
    "input": [
      "CSV (comma-separated, custom delimiters)",
      "Excel (.xlsx, .xls)",
      "MPAI Project Files (custom format)"
    ],
    "output": [
      "CSV",
      "Excel",
      "MPAI Project Files"
    ]
  },
  "ui_components": {
    "main_panels": [
      "Parameters Panel - Parametre seçimi",
      "Statistics Panel - İstatistikler",
      "Correlations Panel - Korelasyon analizi",
      "Bitmask Panel - Bitmask analizi",
      "Parameter Filters Panel - Filtreleme",
      "Graph Settings Panel - Grafik ayarları",
      "Settings Panel - Genel ayarlar"
    ],
    "dialogs": [
      "Data Import Dialog - Gelişmiş veri içe aktarma",
      "Graph Settings Dialog - Grafik yapılandırma",
      "Graph Advanced Settings Dialog - İleri ayarlar"
    ]
  },
  "threading_model": {
    "main_thread": "UI işlemleri",
    "worker_threads": [
      "Data loading (DataLoader)",
      "Data saving (DataSaver)",
      "Filter calculations (FilterCalculationWorker)",
      "System monitoring (SystemMonitorWorker)"
    ],
    "thread_safety": "QThread + Signal/Slot mekanizması"
  },
  "error_handling": {
    "logging": "Python logging module + custom ProductionLogger",
    "error_recovery": "Try-catch blocks ile graceful degradation",
    "user_feedback": "QMessageBox ile kullanıcı bilgilendirme"
  },
  "test_files": [
    "Test_Files/test_data.csv",
    "Test_Files/test_*.csv (10+ test scenarios)",
    "hazir/motor_test_data_350col.csv"
  ],
  "build_configuration": {
    "exe_builder": "tools/build_exe.py",
    "spec_file": "time_graph_app.spec",
    "icon": "ikon.ico",
    "target_os": "Windows (primary), cross-platform capable"
  },
  "known_issues_fixed": [
    "QThread cleanup sorunları - FIXED",
    "High DPI scaling - FIXED",
    "Datetime axis formatting - FIXED",
    "Filter thread safety - IMPROVED",
    "Memory leaks - FIXED"
  ],
  "entry_point": "app.py - main()",
  "application_type": "Desktop Application",
  "target_audience": "Engineering, Data Analysis, Scientific Research"
}

